{
  "name": "jd-charging",
  "private": true,
  "version": "0.1.0",
  "description": "京东充电桩业务线管理工作台 2.0 - 根编排（api / web / db / mocks）",
  "scripts": {
    "dev:api": "wrangler dev --port 8788",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "deploy": "npm run build:web && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "start": "node scripts/local-dev.mjs start",
    "stop": "node scripts/local-dev.mjs stop",
    "status": "node scripts/local-dev.mjs status",
    "dev": "node scripts/local-dev.mjs start",
    "checkpoint": "node scripts/local-dev.mjs checkpoint",
    "restore": "node scripts/local-dev.mjs restore"
  },
  "devDependencies": {
    "wrangler": "^4.135.0"
  }
}
