# 后台程序通过HTTP主动领取，不监听8791，不读取Worker .dev.vars。
WORKER_BASE_URL=http://127.0.0.1:8788
SERVICE_TOKEN=dev-token-service
EXTERNAL_MODE=mock
MOCK_BASE_URL=http://127.0.0.1:8790
MOCK_ACCOUNT_ID=acc-svc-backend
AI_MODE=mock
SKILL_MODEL=deepseek/deepseek-flash
LOOP_INTERVAL_MS=15000
# RUNS_ROOT=/absolute/private/path
# SKILL_PURPOSE=INSTALLATION

# 来源监测程序使用 API_BASE_URL，后台执行程序使用 WORKER_BASE_URL。
API_BASE_URL=http://127.0.0.1:8788
SOURCE_SYSTEMS=installation-admin,provider-docs,jd-billing,provider-receivable,billing-terms,order-entitlement
SOURCE_POLL_INTERVAL_MS=30000
